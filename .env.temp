# Supabase Configuration
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_SECRET_KEY="your_supabase_secret_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_URL="https://your_supabase_project_id.supabase.co"
SUPABASE_JWKS_URL="https://your_supabase_project_id.supabase.co/auth/v1/.well-known/jwks.json"
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"

# Supabase Postgres Connection (Prisma ORM)
# Transaction pooler on port 6543 (for fast app queries)
DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler on port 5432 (for Prisma migrations and schema push)
DIRECT_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
VITE_RAZORPAY_KEY_ID="your_razorpay_key_id"

# Shiprocket Logistics
SHIPROCKET_EMAIL="your_shiprocket_email"
SHIPROCKET_PASSWORD="your_shiprocket_password"

# Brand & Support
VITE_WHATSAPP_NUMBER="+917527869894"
